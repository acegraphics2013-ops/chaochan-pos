APP_NAME="ChaoChan POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# IMPORTANT: Set this to server LAN IP/host reachable by customer phones BEFORE generating QR codes
APP_URL=http://192.168.1.100
# Optional: exact base URL for customer QR links (include port if non-standard), e.g. http://192.168.1.100:8000
# Leave blank to auto-detect the LAN IP + current port.
APP_PUBLIC_URL=
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chaochan_pos_db
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
